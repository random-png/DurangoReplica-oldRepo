<Page
    x:Class="XboxHome2.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XboxHome2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled" d:DesignWidth="1920" XYFocusKeyboardNavigation="Enabled">

    <RelativePanel>
        <MediaPlayerElement AutoPlay="True" Source="ms-appx:///Assets/Sounds/ContentLoad.wav" IsTabStop="False" IsHitTestVisible="False"/>
        <Popup x:Name="NotifPopup" Margin="0,132" IsLightDismissEnabled="True">
            <Frame x:Name="NotifFrame"/>
        </Popup>
        <FontIcon Glyph="" FontFamily="/Assets/Segoe Xbox Symbol v1.07.ttf#Segoe Xbox Symbol" RelativePanel.AlignRightWithPanel="True" FontSize="48" Margin="0,57,98,0"/>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="100,58">
            <Button Style="{StaticResource AccentButtonStyle}" MinHeight="64" MinWidth="64" MaxHeight="64" MaxWidth="64" Padding="0" Click="Notification_Button"> 
                <FontIcon Glyph="&#xE774;" FontSize="38"/>
            </Button>
            <Button MinHeight="64" MinWidth="64" MaxHeight="64" MaxWidth="64" Padding="-2">
                <Grid>
                    <Image Source="/Assets/AppXBranding/SourceIcon.png"/>
                    <Rectangle Height="8" Fill="{ThemeResource SystemAccentColor}" VerticalAlignment="Top" Margin="0,56,0,0"/>
                </Grid>
            </Button>
        </StackPanel>
        <ScrollViewer Margin="0,292,0,0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden">
            <RelativePanel Padding="100,0">
                <Grid x:Name="PinGrid" Margin="0,0,32,0" FlowDirection="RightToLeft" RowSpacing="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="208"/>
                        <RowDefinition Height="208"/>
                        <RowDefinition Height="208"/>
                    </Grid.RowDefinitions>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="0"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="0"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="0"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="1"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="1"/>
                </Grid>
                <Grid x:Name="HomeGrid" RelativePanel.RightOf="PinGrid" Margin="32,0" RowSpacing="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="208"/>
                        <RowDefinition Height="208"/>
                        <RowDefinition Height="208"/>
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.RowSpan="3" Content="Friends"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="1" Grid.ColumnSpan="4" Grid.RowSpan="2" Padding="-2" FocusVisualPrimaryThickness="4" FocusVisualSecondaryThickness="4" FocusVisualMargin="-8">
                        <Grid>
                            <ProgressBar Foreground="{ThemeResource SystemAccentColor}" Background="{ThemeResource SystemAccentColorDark2}" Value="18" Height="428" Width="864"/>
                            <TextBlock Text="Most recent" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="5" Content="Snap"/>
                    <Button x:Name="InstallListButton" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="5" Grid.Row="1" Content="My games &amp; apps" Click="InstallList" FocusVisualPrimaryThickness="4" FocusVisualSecondaryThickness="4" FocusVisualMargin="-8"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="5" Grid.Row="2" Content="Disc"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="4" Content="Recent 1"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="2" Grid.Row="4" Content="Recent 2"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="3" Grid.Row="4" Content="Recent 3"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="4" Grid.Row="4" Content="Recent 4"/>
                </Grid>
                <Grid x:Name="FeaturedGrid" RelativePanel.RightOf="HomeGrid" Margin="32,0" RowSpacing="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="372"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="208"/>
                        <RowDefinition Height="208"/>
                        <RowDefinition Height="208"/>
                    </Grid.RowDefinitions>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="3"/>
                </Grid>
                <Grid x:Name="StoreGrid" RelativePanel.RightOf="FeaturedGrid" Margin="32,0,0,0" RowSpacing="50" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="370"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="532"/>
                        <RowDefinition Height="64"/>
                    </Grid.RowDefinitions>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="0"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="1"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="2"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="3"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.ColumnSpan="4" FontSize="18" FontWeight="SemiBold" Content="Search the Microsoft Store" HorizontalContentAlignment="Left" Background="White" Foreground="Black"/>
                </Grid>
            </RelativePanel>
        </ScrollViewer>
    </RelativePanel>
</Page>
