<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbui="using:XboxMessages.Controls"
    xmlns:local="using:XboxMessages">

    <Thickness x:Key="XBPersonPictureThickness">1</Thickness>
    <StaticResource x:Key="XBPersonPictureBackground" ResourceKey="SystemControlTransparentBrush"/>
    <StaticResource x:Key="XBPersonPictureForeground" ResourceKey="ApplicationSecondaryForegroundThemeBrush"/>
    <SolidColorBrush x:Key="XBPersonPicture360BackplateColor" Color="#BFBFBF"/>
    <x:Double x:Key="XBMaxSize">72</x:Double>

    <Style TargetType="xbui:CustomPersonPicture">
        <Setter Property="Background" Value="{ThemeResource XBPersonPictureBackground}"/>
        <Setter Property="Foreground" Value="{ThemeResource XBPersonPictureForeground}"/>
        <Setter Property="BorderBrush" Value="#56FFFFFF"/>
        <Setter Property="BorderThickness" Value="{ThemeResource XBPersonPictureThickness}"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="xbui:CustomPersonPicture">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BackgroundSizing="OuterBorderEdge" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.38"/>
                        </Grid.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="IconStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Normal" To="Classic">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)" EnableDependentAnimation="True">
                                                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                                <LinearDoubleKeyFrame KeyTime="00:00:00.2" Value="0.6"/>
                                                <EasingDoubleKeyFrame KeyTime="00:00:00.250" Value="1.3"/>
                                                <SplineDoubleKeyFrame KeyTime="00:00:00.3" Value="1" KeySpline="0,0,0,1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" EnableDependentAnimation="True">
                                                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                                <LinearDoubleKeyFrame KeyTime="00:00:00.2" Value="0.6"/>
                                                <EasingDoubleKeyFrame KeyTime="00:00:00.250" Value="1.3"/>
                                                <SplineDoubleKeyFrame KeyTime="00:00:00.3" Value="1" KeySpline="0,0,0,1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Modern"/>
                                <VisualState x:Name="Classic">
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IconBackplate" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="MaxWidth">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource XBMaxSize}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="MaxHeight">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource XBMaxSize}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <FontIcon x:Name="PlaceholderGlyph" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontFamily="/Assets/Segoe Xbox Symbol v1.07.ttf#Segoe Xbox Symbol" Glyph="&#xE301;" FontSize="29" Margin="0,-3,0,0"/>
                        <Border x:Name="IconBackplate" Background="{ThemeResource XBPersonPicture360BackplateColor}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
                        <Image x:Name="ProfilePicture" Stretch="UniformToFill" Source="{TemplateBinding ProfilePicture}" HorizontalAlignment="Stretch" RenderTransformOrigin=".5,.5">
                            <Image.RenderTransform>
                                <CompositeTransform/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
