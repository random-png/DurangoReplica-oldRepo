<Page
    x:Class="XboxMessages.Pages.SnapUI.MessagesSnapHome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XboxMessages.Pages.SnapUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xbui="using:XboxMessages.Controls"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    d:Width="480"
    d:Height="1080"
    Background="#313131">
    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition FromHorizontalOffset="500" FromVerticalOffset="0"/>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Width="480">
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/videoframe_78680-cropped.png" Stretch="UniformToFill" Opacity="0"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <FontIcon Canvas.ZIndex="1" Glyph="" FontFamily="/Assets/Segoe Xbox Symbol v1.07.ttf#Segoe Xbox Symbol" RelativePanel.AlignRightWithPanel="True" FontSize="48" Margin="0,57,98,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>
        <RelativePanel Grid.Row="0" Padding="24,28" Background="{ThemeResource SystemAccentColor}">
            <TextBlock x:Name="ScreenTitle" Text="Messages" FontSize="48" FontWeight="ExtraLight" Margin="0,0,0,8" TextLineBounds="TrimToCapHeight" OpticalMarginAlignment="TrimSideBearings" RelativePanel.Above="UsernameText"/>
            <TextBlock x:Name="UsernameText" Text="Username" FontSize="26" FontWeight="Light" TextLineBounds="Tight" OpticalMarginAlignment="TrimSideBearings" RelativePanel.AlignBottomWithPanel="True"/>
        </RelativePanel>
        <ListView x:Name="ThreadList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Hidden" SingleSelectionFollowsFocus="False" SelectionMode="None" ItemContainerStyle="{ThemeResource SnapHomeMessageListItem}" IsItemClickEnabled="True" ItemClick="ThreadList_ItemClick">
            <ListView.Header>
                <Button x:Name="NewMessageButton" HorizontalContentAlignment="Left" Padding="24,0,0,0" FocusVisualSecondaryThickness="4" FocusVisualPrimaryThickness="4" Background="Transparent" HorizontalAlignment="Stretch" Height="100" Margin="0,0,0,8" BorderThickness="0,0,0,1" FocusVisualMargin="-8,-8" BorderBrush="#4CFFFFFF" Style="{ThemeResource DefaultButtonStyleAlt}">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <FontIcon Glyph="&#xE3A5;" FontSize="28"/>
                        <TextBlock FontSize="24" Text="New message" VerticalAlignment="Center" CharacterSpacing="20"/>
                    </StackPanel>
                </Button>
            </ListView.Header>
            <ListViewItem Padding="0" FocusVisualSecondaryThickness="4" FocusVisualPrimaryThickness="4" FocusVisualMargin="-8,-4">
                <Grid Width="480">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <RelativePanel>
                        <xbui:CustomPersonPicture Height="136" Width="136" BorderThickness="0" ProfilePicture="/Assets/videoframe_78680-cropped.png" IconStyle="Classic"/>
                        <Path Data="M68 0H0L68 68V0Z" Fill="{ThemeResource SystemAccentColor}" RelativePanel.AlignRightWithPanel="True"/>
                        <TextBlock Text="3" FontFamily="Segoe UI" FontSize="24" RelativePanel.AlignRightWithPanel="True" Margin="0,2,16,0" TextAlignment="Right"/>
                    </RelativePanel>
                    <Rectangle x:Name="UnknownLine" Width="7" Height="136" Fill="Lime" Grid.Column="1" Margin="0" HorizontalAlignment="Left"/>
                    <Ellipse x:Name="OnlineIndicator" Width="8" Height="8" Fill="Lime" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,30,0,0"/>
                    <StackPanel Spacing="4" Grid.Column="1" Margin="37,16,0,0">
                        <TextBlock FontWeight="ExtraBold" Text="DaffodilHydra94" FontSize="24" CharacterSpacing="16" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap" HorizontalAlignment="Stretch"/>
                        <TextBlock FontWeight="Normal" Text="Hoi" FontSize="24" CharacterSpacing="16" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap" HorizontalAlignment="Stretch"/>
                        <TextBlock FontWeight="Normal" Text="7:01 PM" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap" FontSize="24" CharacterSpacing="0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </ListViewItem>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
            <ListViewItem/>
