<Page
    x:Class="XboxHome.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XboxHome"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <RelativePanel>
        <RelativePanel.ChildrenTransitions>
            <TransitionCollection>
                <NavigationThemeTransition>
                    <CommonNavigationTransitionInfo IsStaggeringEnabled="True"/>
                </NavigationThemeTransition>
            </TransitionCollection>
        </RelativePanel.ChildrenTransitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="100,58">
            <Button Style="{StaticResource AccentButtonStyle}" MinHeight="64" MinWidth="64" MaxHeight="64" MaxWidth="64"/>
            <Button MinHeight="64" MinWidth="64" MaxHeight="64" MaxWidth="64" Padding="0">
                <Image Source="/Assets/AppXBranding/SourceIcon.png"/>
            </Button>
        </StackPanel>
        <ScrollViewer Margin="0,288,0,146" RelativePanel.AlignVerticalCenterWithPanel="True" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden">
            <RelativePanel Padding="100,0">
                <Grid x:Name="PinGrid" FlowDirection="RightToLeft" Margin="0,0,32,0" RowSpacing="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="210"/>
                    </Grid.RowDefinitions>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="5" Click="InstallList"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="5"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="5"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="4"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="4"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="4"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="3"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="3"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="3"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="2"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="2"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="2"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="1"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="1"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="1"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="0"/>
                </Grid>
                <Grid x:Name="HomeGrid" RelativePanel.RightOf="PinGrid" Margin="32,0" RowSpacing="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="210"/>
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.RowSpan="3" Content="Friends"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="1" Grid.ColumnSpan="4" Grid.RowSpan="2" Content="Most recent"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="5" Content="Snap"/>
                    <Button x:Name="InstallListButton" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="5" Grid.Row="1" Content="My games &amp; apps" Click="InstallList" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="3" FocusVisualSecondaryBrush="Black"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="5" Grid.Row="2" Content="Disc"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="4" Content="Recent 1"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="2" Grid.Row="4" Content="Recent 2"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="3" Grid.Row="4" Content="Recent 3"/>
                    <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="4" Grid.Row="4" Content="Recent 4"/>
                </Grid>
                <Grid x:Name="FeaturedGrid" RelativePanel.RightOf="HomeGrid" Margin="32,0" RowSpacing="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="372"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="210"/>
                    </Grid.RowDefinitions>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="3"/>
                </Grid>
                <Grid x:Name="StoreGrid" RelativePanel.RightOf="FeaturedGrid" Margin="32,0,0,0" RowSpacing="50" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="370"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="532"/>
                        <RowDefinition Height="64"/>
                    </Grid.RowDefinitions>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="0"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="1"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="2"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="3"/>
                    <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.ColumnSpan="4" FontSize="18" FontWeight="SemiBold" Content="Search the Microsoft Store, or say &quot;Xbox, Bing&quot; to search with your voice" HorizontalContentAlignment="Left" Background="White" Foreground="Black"/>
                </Grid>
            </RelativePanel>
        </ScrollViewer>
    </RelativePanel>
</Page>
