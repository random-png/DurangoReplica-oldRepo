<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:xbui="using:XboxMusic.Controls"
    xmlns:local="using:XboxMusic">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="XBPersonPictureBorderBrush" Color="#56FFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="XBPersonPictureBorderBrush" Color="#56000000"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="XBPersonPictureBorderThickness">1</Thickness>
    <StaticResource x:Key="XBPersonPictureBackground" ResourceKey="SystemControlTransparentBrush"/>
    <StaticResource x:Key="XBPersonPictureForeground" ResourceKey="ApplicationSecondaryForegroundThemeBrush"/>
    <SolidColorBrush x:Key="XBPersonPicture360BackplateColor" Color="#BFBFBF"/>
    <x:Double x:Key="XBMaxSize">72</x:Double>

    <Style TargetType="xbui:CustomPersonPicture">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="{ThemeResource XBPersonPictureBackground}"/>
        <Setter Property="Foreground" Value="{ThemeResource XBPersonPictureForeground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource XBPersonPictureBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{ThemeResource XBPersonPictureBorderThickness}"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="xbui:CustomPersonPicture">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BackgroundSizing="OuterBorderEdge" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.38"/>
                        </Grid.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="IconStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Modern" To="Classic">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)">
                                                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                                <LinearDoubleKeyFrame KeyTime="00:00:00.198" Value="0.2"/>
                                                <EasingDoubleKeyFrame KeyTime="00:00:00.320" Value="2"/>
                                                <SplineDoubleKeyFrame KeyTime="00:00:00.548" Value="1" KeySpline="0,0,0,1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                                                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                                <LinearDoubleKeyFrame KeyTime="00:00:00.198" Value="0.2"/>
                                                <EasingDoubleKeyFrame KeyTime="00:00:00.320" Value="2"/>
                                                <SplineDoubleKeyFrame KeyTime="00:00:00.548" Value="1" KeySpline="0,0,0,1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="0" Value="1"/>
                                                <SplineDoubleKeyFrame KeyTime="00:00:00.182" Value="0" KeySpline="0,0,0,1"/>
                                                <SplineDoubleKeyFrame KeyTime="00:00:00.320" Value="0"/>
                                                <SplineDoubleKeyFrame KeyTime="00:00:00.548" Value="1" KeySpline="0,0,0,1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00.320" Storyboard.TargetName="ClassicBackplate" Storyboard.TargetProperty="Opacity">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                                <SplineDoubleKeyFrame KeyTime="00:00:00.122" Value="1" KeySpline="0,0,0,1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00.320" Storyboard.TargetName="ClassicBackplate" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00.320" Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="MaxWidth">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource XBMaxSize}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00.320" Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="MaxHeight">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource XBMaxSize}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00.320" Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Modern"/>
                                <VisualState x:Name="Classic">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.BorderThickness" Value="0"/>
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClassicBackplate" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="MaxWidth">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource XBMaxSize}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ProfilePicture" Storyboard.TargetProperty="MaxHeight">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource XBMaxSize}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <FontIcon x:Name="PlaceholderGlyph" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontFamily="/Assets/Segoe Xbox Symbol v1.07.ttf#Segoe Xbox Symbol" Glyph="&#xE301;" FontSize="29" Margin="0,-3,0,0"/>
                        <Border x:Name="ClassicBackplate" Background="{ThemeResource XBPersonPicture360BackplateColor}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
                        <Image x:Name="ProfilePicture" Stretch="UniformToFill" Source="{TemplateBinding ProfilePicture}" HorizontalAlignment="Stretch" RenderTransformOrigin=".5,.5">
                            <Image.RenderTransform>
                                <CompositeTransform/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="xbui:TileButton">
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="Background" Value="{ThemeResource SystemAccentColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FocusVisualMargin" Value="{ThemeResource FocusVisualMargin}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{ThemeResource FocusVisualThickness}"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="{ThemeResource FocusVisualThickness}"/>
        <Setter Property="IconMargin" Value="0,0,0,8"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
        <Setter Property="IconFontSize" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="xbui:TileButton">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ReadableTextBackdrop" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" EnableDependentAnimation="True" To="0">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PrimaryFocusVisual" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="SecondaryFocusVisual" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="PrimaryFocusVisual.Margin" Value="-4"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ReadableTextBackdrop" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" EnableDependentAnimation="True" To="1">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PrimaryFocusVisual" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="SecondaryFocusVisual" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <FontIcon Glyph="&#xE455;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="{TemplateBinding IconFontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding IconMargin}"/>
                        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Left" ui:UIElementExtensions.ClipToBounds="True">
                            <Rectangle x:Name="ReadableTextBackdrop" Fill="#B5000000" RenderTransformOrigin=".5,1">
                                <Rectangle.RenderTransform>
                                    <CompositeTransform x:Name="CompositeTransform" ScaleY="0.0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <TextBlock x:Name="TileTextDisplay" Text="{TemplateBinding TileText}" Padding="16,10,16,12" Foreground="{TemplateBinding Foreground}" TextWrapping="WrapWholeWords" FontSize="24"/>
                        </Grid>
                        <Rectangle x:Name="PrimaryFocusVisual" Stroke="{TemplateBinding FocusVisualPrimaryBrush}" StrokeThickness="{ThemeResource FocusVisualThickness}" Opacity="0" IsHitTestVisible="False" ui:Effects.Shadow="{ThemeResource ButtonShadow}"/>
                        <Rectangle x:Name="SecondaryFocusVisual" Stroke="{TemplateBinding FocusVisualSecondaryBrush}" StrokeThickness="{ThemeResource FocusVisualThickness}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
