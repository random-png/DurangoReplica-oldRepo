<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:f="using:Windows.Foundation">
    <Style x:Key="XboxProgressRing" TargetType="ProgressRing">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="{StaticResource ProgressRingSize}" />
        <Setter Property="Width" Value="{StaticResource ProgressRingSize}" />
        <Setter Property="MinHeight" Value="{StaticResource ProgressRingMinSize}" />
        <Setter Property="MinWidth" Value="{StaticResource ProgressRingMinSize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressRing">
                    <Grid x:Name="RootGrid" Opacity="0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ActiveStates">
                                <VisualStateGroup.States>
                                    <VisualState x:Name="Inactive" />
                                    <VisualState x:Name="Active">
                                        <VisualState.Storyboard>
                                            <Storyboard SpeedRatio="1.5">
                                                <Storyboard.Children>
                                                    <DoubleAnimation
                                                            Duration="0:0:0.1"
                                                            BeginTime="0:0:1.6"
                                                            From="0"
                                                            To="1"
                                                            Storyboard.TargetProperty="(UIElement.Opacity)"
                                                            Storyboard.TargetName="RootGrid" />
                                                    <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.6" Storyboard.TargetProperty="Angle" Storyboard.TargetName="path1Rotate">
                                                        <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-355" EasingFunction="{StaticResource Exponent4}" />
                                                            <EasingDoubleKeyFrame KeyTime="00:00:01.6000000" Value="-5" EasingFunction="{StaticResource Exponent4}" />
                                                        </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.6" Storyboard.TargetProperty="Angle" Storyboard.TargetName="postion1Rotate">
                                                        <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-5" EasingFunction="{StaticResource Exponent4}" />
                                                            <EasingDoubleKeyFrame KeyTime="00:00:01.6000000" Value="180" EasingFunction="{StaticResource Exponent4}" />
                                                        </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames
                                                            RepeatBehavior="Forever"
                                                            Duration="0:0:1.6"
                                                            BeginTime="0:0:0.1"
                                                            Storyboard.TargetProperty="Angle"
                                                            Storyboard.TargetName="path2Rotate">
                                                        <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-355" EasingFunction="{StaticResource Exponent4}" />
                                                            <EasingDoubleKeyFrame KeyTime="00:00:01.5000000" Value="-5" EasingFunction="{StaticResource Exponent4}" />
                                                        </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames
                                                            RepeatBehavior="Forever"
                                                            Duration="0:0:1.6"
                                                            BeginTime="0:0:0.1"
                                                            Storyboard.TargetProperty="Angle"
                                                            Storyboard.TargetName="postion2Rotate">
                                                        <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-5" EasingFunction="{StaticResource Exponent4}" />
                                                            <EasingDoubleKeyFrame KeyTime="00:00:01.5000000" Value="180" EasingFunction="{StaticResource Exponent4}" />
                                                        </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames
                                                            RepeatBehavior="Forever"
                                                            Duration="0:0:1.6"
                                                            BeginTime="0:0:0.2"
                                                            Storyboard.TargetProperty="Angle"
                                                            Storyboard.TargetName="path3Rotate">
                                                        <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-355" EasingFunction="{StaticResource Exponent4}" />
                                                            <EasingDoubleKeyFrame KeyTime="00:00:01.4000000" Value="-5" EasingFunction="{StaticResource Exponent4}" />
                                                        </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames
                                                            RepeatBehavior="Forever"
                                                            Duration="0:0:1.6"
                                                            BeginTime="0:0:0.2"
                                                            Storyboard.TargetProperty="Angle"
                                                            Storyboard.TargetName="postion3Rotate">
                                                        <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-5" EasingFunction="{StaticResource Exponent4}" />
                                                            <EasingDoubleKeyFrame KeyTime="00:00:01.4000000" Value="180" EasingFunction="{StaticResource Exponent4}" />
                                                        </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.6" BeginTime="0:0:0.3" Storyboard.TargetProperty="Angle" Storyboard.TargetName="path4Rotate">
                                                        <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-355" EasingFunction="{StaticResource Exponent4}" />
                                                            <EasingDoubleKeyFrame KeyTime="00:00:01.4000000" Value="-5" EasingFunction="{StaticResource Exponent4}" />
                                                        </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.6" BeginTime="0:0:0.3" Storyboard.TargetProperty="Angle" Storyboard.TargetName="postion4Rotate">
                                                        <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-5" EasingFunction="{StaticResource Exponent4}" />
                                                            <EasingDoubleKeyFrame KeyTime="00:00:01.4000000" Value="180" EasingFunction="{StaticResource Exponent4}" />
                                                        </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard.Children>
                                            </Storyboard>
                                        </VisualState.Storyboard>
                                    </VisualState>
                                </VisualStateGroup.States>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Viewbox Stretch="Fill">
                            <Viewbox.Child>
                                <Grid>
                                    
                                        <Grid>
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="postion4Rotate" CenterX="{StaticResource OutsideRadius}" CenterY="{StaticResource OutsideRadius}" />
                                            </Grid.RenderTransform>
                                            
                                                <Grid>
                                                    <Grid.Clip>
                                                        <RectangleGeometry Rect="{StaticResource ProgressRingOuterClipRect}" />
                                                    </Grid.Clip>
                                                    
                                                        <Path Fill="{ThemeResource ProgressRingAccentBrush3}">
                                                            <Path.RenderTransform>
                                                                <RotateTransform x:Name="path4Rotate" CenterX="{StaticResource OutsideRadius}" CenterY="{StaticResource OutsideRadius}" />
                                                            </Path.RenderTransform>
                                                            <Path.Data>
                                                                <GeometryGroup FillRule="EvenOdd">
                                                                    <GeometryGroup.Children>
                                                                        <EllipseGeometry RadiusX="{StaticResource InsideRadius}" RadiusY="{StaticResource InsideRadius}" Center="{StaticResource ProgressRingCenterPoint}" />
                                                                        <EllipseGeometry RadiusX="{StaticResource OutsideRadius}" RadiusY="{StaticResource OutsideRadius}" Center="{StaticResource ProgressRingCenterPoint}" />
                                                                    </GeometryGroup.Children>
                                                                </GeometryGroup>
                                                            </Path.Data>
                                                            <Path.Clip>
                                                                <RectangleGeometry Rect="{StaticResource ProgressRingInnerClipRect}" />
                                                            </Path.Clip>
                                                        </Path>
                                                    
                                                </Grid>
                                            
                                        </Grid>
                                        <Grid>
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="postion3Rotate" CenterX="{StaticResource OutsideRadius}" CenterY="{StaticResource OutsideRadius}" />
                                            </Grid.RenderTransform>

                                        <Grid>
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="{StaticResource ProgressRingOuterClipRect}" />
                                            </Grid.Clip>

                                            <Path Fill="{ThemeResource ProgressRingAccentBrush}">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="path3Rotate" CenterX="{StaticResource OutsideRadius}" CenterY="{StaticResource OutsideRadius}" />
                                                </Path.RenderTransform>
                                                <Path.Data>
                                                    <GeometryGroup FillRule="EvenOdd">
                                                        <GeometryGroup.Children>
                                                            <EllipseGeometry RadiusX="{StaticResource InsideRadius}" RadiusY="{StaticResource InsideRadius}" Center="{StaticResource ProgressRingCenterPoint}" />
                                                            <EllipseGeometry RadiusX="{StaticResource OutsideRadius}" RadiusY="{StaticResource OutsideRadius}" Center="{StaticResource ProgressRingCenterPoint}" />
                                                        </GeometryGroup.Children>
                                                    </GeometryGroup>
                                                </Path.Data>
                                                <Path.Clip>
                                                    <RectangleGeometry Rect="{StaticResource ProgressRingInnerClipRect}" />
                                                </Path.Clip>
                                            </Path>
                                        </Grid>
                                    </Grid>
                                        <Grid>
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="postion2Rotate" CenterX="{StaticResource OutsideRadius}" CenterY="{StaticResource OutsideRadius}" />
                                            </Grid.RenderTransform>
                                            <Grid>
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="{StaticResource ProgressRingOuterClipRect}" />
                                            </Grid.Clip>
                                            <Path Fill="{ThemeResource ProgressRingAccentBrush2}">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="path2Rotate" CenterX="{StaticResource OutsideRadius}" CenterY="{StaticResource OutsideRadius}" />
                                                </Path.RenderTransform>
                                                <Path.Data>
                                                    <GeometryGroup FillRule="EvenOdd">
                                                        <GeometryGroup.Children>
                                                            <EllipseGeometry RadiusX="{StaticResource InsideRadius}" RadiusY="{StaticResource InsideRadius}" Center="{StaticResource ProgressRingCenterPoint}" />
                                                            <EllipseGeometry RadiusX="{StaticResource OutsideRadius}" RadiusY="{StaticResource OutsideRadius}" Center="{StaticResource ProgressRingCenterPoint}" />
                                                        </GeometryGroup.Children>
                                                    </GeometryGroup>
                                                </Path.Data>
                                                <Path.Clip>
                                                    <RectangleGeometry Rect="{StaticResource ProgressRingInnerClipRect}" />
                                                </Path.Clip>
                                            </Path>
                                        </Grid>
                                        </Grid>
                                    <Grid>
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="postion1Rotate" Angle="-5" CenterX="{StaticResource OutsideRadius}" CenterY="{StaticResource OutsideRadius}" />
                                        </Grid.RenderTransform>
                                        <Grid>
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="{StaticResource ProgressRingOuterClipRect}" />
                                            </Grid.Clip>
                                            <Path Fill="{ThemeResource ProgressRingStartBrush}">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="path1Rotate" CenterX="{StaticResource OutsideRadius}" CenterY="{StaticResource OutsideRadius}" />
                                                </Path.RenderTransform>
                                                <Path.Data>
                                                    <GeometryGroup FillRule="EvenOdd">
                                                        <GeometryGroup.Children>
                                                            <EllipseGeometry RadiusX="{StaticResource InsideRadius}" RadiusY="{StaticResource InsideRadius}" Center="{StaticResource ProgressRingCenterPoint}" />
                                                            <EllipseGeometry RadiusX="{StaticResource OutsideRadius}" RadiusY="{StaticResource OutsideRadius}" Center="{StaticResource ProgressRingCenterPoint}" />
                                                        </GeometryGroup.Children>
                                                    </GeometryGroup>
                                                </Path.Data>
                                                <Path.Clip>
                                                    <RectangleGeometry Rect="{StaticResource ProgressRingInnerClipRect}" />
                                                </Path.Clip>
                                            </Path>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Viewbox.Child>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <x:Double x:Key="ProgressRingSize">96</x:Double>
    <f:Rect x:Key="ProgressRingOuterClipRect">212,0,212,424</f:Rect>
    <x:Double x:Key="ProgressRingMinSize">30</x:Double>
    <f:Rect x:Key="ProgressRingInnerClipRect">0,0,212,424</f:Rect>
    <f:Point x:Key="ProgressRingCenterPoint">212,212</f:Point>
    <StaticResource x:Key="ProgressRingStartBrush" ResourceKey="ApplicationForegroundThemeBrush"/>
    <SolidColorBrush x:Key="ProgressRingAccentBrush" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ProgressRingAccentBrush2" Color="{ThemeResource SystemAccentColor}" Opacity="0.6"/>
    <SolidColorBrush x:Key="ProgressRingAccentBrush3" Color="{ThemeResource SystemAccentColor}" Opacity="0.3"/>
    <x:Double x:Key="OutsideRadius">212</x:Double>
    <x:Double x:Key="InsideRadius">196</x:Double>
    <Style x:Key="HeaderXboxProgressRing" TargetType="ProgressRing" BasedOn="{StaticResource XboxProgressRing}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="44,0,0,0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
    </Style>
    <ExponentialEase x:Name="Exponent4" x:Key="Exponent4" EasingMode="EaseInOut" Exponent="4" />
    <Style x:Key="ContentXboxProgressRing" TargetType="ProgressRing" BasedOn="{StaticResource XboxProgressRing}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="88" />
    </Style>
</ResourceDictionary>
